[server]
# IP address and port of the CGI backend server on the LAN
SERVER_URL = http://192.168.1.10:8000

# API token for the Pi node (set in backend .env as PI_NODE_TOKEN)
PI_NODE_TOKEN = CHANGE_ME

# Pi HTTP server settings (pi_server.py)
# The backend will call this server to poll weight and trigger captures.
PI_SERVER_HOST = 0.0.0.0
PI_SERVER_PORT = 5000

[camera]
# Resolution for captured images (width x height)
RESOLUTION_WIDTH  = 1920
RESOLUTION_HEIGHT = 1080
# Still image format
IMAGE_FORMAT = jpeg
# manual matches the confirmed terminal capture; auto runs a cycle for each still.
# continuous keeps focusing during live preview. Verify focus on the mounted tray.
FOCUS_MODE = manual
# Optional manual position in dioptres; blank preserves the initial position.
LENS_POSITION =
# Exposure/focus settling time in seconds
AUTOFOCUS_WAIT = 1.5

[load_cell]
# Temporary acquisition-only Stage 2 mode; never writes raw counts as grams.
WEIGHT_SENSOR_TEST_MODE = false
# Bypass ONLY the 340–360 g range; calibration, freshness and stability still required.
# Enable WEIGHT_TEST_MODE in the backend .env as well.
WEIGHT_TEST_MODE = false
# GPIO data pin connected to HX711 DT
HX711_DT_PIN  = 5
# GPIO clock pin connected to HX711 SCK
HX711_SCK_PIN = 6
# Calibration factor (run hx711_reader.py --calibrate to find this value).
# May be negative — sign depends on load cell wiring orientation.
CALIBRATION_FACTOR = 1.0
# Set by the verification wizard, never by guessing a factor/sign.
CALIBRATION_VERIFIED = false
# Maximum accepted spread within a batch/reference and between readings (grams).
# Existing 0.5 g acceptance target; verify against observed empty/loaded noise.
MAX_SPREAD_G = 0.5
# Continuous recent-window stability; tune using real empty/loaded observations.
STABILITY_DURATION_S = 1.0
UNSTABLE_AFTER_S = 8.0
# Minimum distinguishable sample mass above empty-tray noise; tune physically.
SAMPLE_NOISE_FLOOR_G = 1.0
# Persisted by --tare / --calibrate and the transaction Tare button.
ZERO_OFFSET = 0
# Samples collected per weight reading (more = slower but smoother).
# 5–40 valid samples; rolling median of 5 followed by a short mean.
READINGS_TO_AVERAGE = 20
# Acceptable weight range for 350 g sample (grams)
WEIGHT_MIN_G = 340
WEIGHT_MAX_G = 360

[gpio]
# GPIO pin for physical trigger button (BCM numbering)
TRIGGER_BUTTON_PIN = 17
# GPIO pin for status LED (optional)
STATUS_LED_PIN = 27

[hardware]
# auto simulates only on non-Pi hosts; hardware never falls back on driver failure.
MODE = auto
