# ============================================================
# Coffee Grade Identification (CGI) — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Application -----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ----- Database (dedicated runtime account; see backend/RASPBERRY_PI_AUDIT.md) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cgi_db
DB_USER=cgi_app
DB_PASSWORD=CHANGE_ME

# ----- JWT Authentication -----
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ----- YOLOv8 Model -----
# Path to the trained .pt model file (relative to project root or absolute)
YOLO_MODEL_PATH=models/cgi_yolov8.pt
# Minimum confidence threshold for detections (0.0 – 1.0)
YOLO_CONFIDENCE=0.50

# ----- File Storage -----
UPLOAD_DIR=backend/static/uploads

# ----- External Pricing API -----
# Replace with BAFS endpoint when available
PRICE_API_URL=https://commodities-api.com/api/latest
PRICE_API_KEY=
# Coffee commodity symbol on the chosen API (e.g. COFFEE, KC)
PRICE_API_SYMBOL=COFFEE
# Base currency for price conversion
PRICE_BASE_CURRENCY=PHP
# How long (seconds) to cache the fetched price before re-fetching
PRICE_CACHE_TTL_SECONDS=3600
# Fallback price (PHP per kg) used if the API is unreachable
PRICE_FALLBACK_PHP_PER_KG=300.00

# ----- Pi Node HTTP Server -----
# URL of the pi_server.py process running on the Raspberry Pi
# Change to the Pi's LAN IP in production (e.g. http://192.168.1.20:5000)
PI_NODE_URL=http://localhost:5000

# ----- Thermal Printer -----
# Set THERMAL_PRINTER_TYPE to "network" or "usb"
THERMAL_PRINTER_TYPE=network
THERMAL_PRINTER_HOST=192.168.1.100
THERMAL_PRINTER_PORT=9100
# For USB: set VID/PID (find with `lsusb` or Device Manager)
THERMAL_PRINTER_USB_VID=0x04b8
THERMAL_PRINTER_USB_PID=0x0202

# ----- CORS (comma-separated allowed origins) -----
# Origins must be exact scheme/host/port values; CIDR ranges are not supported.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://cgi.local

# Temporary Step 2 HX711 acquisition testing; restore false after verification.
WEIGHT_TEST_MODE=false

# Temporary workflow testing: skip analysis only when the trained model is missing.
YOLO_ALLOW_MISSING_MODEL=false

# Temporary Stage 2 acquisition-only mode; bypasses weight acceptance for Capture.
WEIGHT_SENSOR_TEST_MODE=false
